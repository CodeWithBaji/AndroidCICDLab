# Copy this file to keystore.properties (gitignored) and fill in local values.
# Never commit keystore.properties, *.jks, or *.keystore.
#
# Local signing:
#   1. Generate a upload keystore (do this once, store it in a secrets manager):
#        keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#   2. Copy this file to keystore.properties
#   3. Point storeFile at your local keystore
#
# CI signing:
#   GitHub Secrets (see docs/signing.md)
#     KEYSTORE_BASE64
#     KEYSTORE_PASSWORD
#     KEY_ALIAS
#     KEY_PASSWORD

storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
